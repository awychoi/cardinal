#!/bin/sh
# Secret scan before every commit.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Uses gitleaks (https://github.com/gitleaks/gitleaks) with the repository
# config in .gitleaks.toml. Install it with: brew install gitleaks
# Bypass for one commit with: git commit --no-verify

set -eu

root="$(git rev-parse --show-toplevel)"
cd "$root"

run_scan() {
  "$1" git --pre-commit --redact --staged --verbose --config .gitleaks.toml .
}

# Gitleaks does not know this app's file extensions, so a committed vault,
# backup, or plaintext ledger export would pass it, and it skips binary key
# stores. Mirrors the CI check so the commit is refused locally, before it can
# reach a public remote.
reject_artifacts() {
  artifacts="$(git diff --cached --name-only --diff-filter=ACMR | grep -E \
    '\.cmdb(-wal|-shm|-journal)?$|\.cmdb\.restore-old$|\.cmbak$|vault\.header(\.bak)?$|cardinal-ledger-.*\.csv$|\.cm-export-.*\.tmp$|(^|/)\.env($|\.[^/]+$)|(^|/)\.envrc$|(^|/)\.netrc$|(^|/)_netrc$|(^|/)\.git-credentials$|(^|/)id_(rsa|ecdsa|ed25519)$|\.p8$|\.p12$|\.pfx$|\.jks$|\.keystore$|\.mobileprovision$|(^|/)service-account[^/]*\.json$|(^|/)credentials\.json$' \
    | grep -vE '(^|/)\.env\.(example|sample|template)$' || true)"
  if [ -n "$artifacts" ]; then
    echo "pre-commit: refusing to commit a vault, backup, plaintext ledger export, or key/credential file:" >&2
    echo "$artifacts" >&2
    echo "  Remove it with: git rm --cached <file>" >&2
    exit 1
  fi
}

if command -v gitleaks >/dev/null 2>&1; then
  run_scan gitleaks
elif [ -x "$root/.cache/gitleaks/gitleaks" ]; then
  run_scan "$root/.cache/gitleaks/gitleaks"
else
  echo "pre-commit: gitleaks is not installed, so this commit was NOT scanned." >&2
  echo "  Install it with: brew install gitleaks" >&2
  echo "  Or bypass once with: git commit --no-verify" >&2
  exit 1
fi

reject_artifacts
